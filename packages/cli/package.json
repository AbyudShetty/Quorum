      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "dependencies": {
    "@quorum/adapter-hooks": "0.0.0",
    "@quorum/adapter-mcp": "0.0.0",
    "@quorum/codex-bridge": "0.0.0",
    "@quorum/core": "0.0.0",
    "@quorum/local": "0.0.0",
    "@quorum/schemas": "0.0.0",
    "@quorum/server": "0.0.0"
  }
}
