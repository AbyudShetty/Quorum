{
  "name": "@quorum/cli",
  "version": "0.0.0",
  "private": true,
  "description": "The quorum command line: serve, login, workspaces, attach, status, inbox, send, verify, export and the MCP server entry point.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "quorum": "./bin/quorum.js"
  },
  "exports": {
